# 翻译服务配置
# 首次部署请复制为 .env 后填写；已有 .env 时不要覆盖

# OpenAI兼容API接口地址（默认使用官方OpenAI API）
OPENAI_API_URL=https://api.openai.com/v1

# OpenAI兼容API密钥
OPENAI_API_KEY=your_openai_api_key_here

# AI模型名称（默认使用gpt-3.5-turbo，可根据需要修改）
OPENAI_MODEL=gpt-3.5-turbo

# 默认翻译服务：openai（上方 OpenAI 兼容 API）或 index（bilibili Index-Translate 免费公共 API）
# 页面“API 设置”中可按浏览器单独切换
TRANSLATION_PROVIDER=openai

# Index-Translate 配置（无需 Key；一般保持默认即可）
INDEX_TRANSLATE_API_URL=https://index-translate.bilibili.com/v1
INDEX_TRANSLATE_MODEL=Index-Translate-35B-A3B

# Docker 对外端口；容器内部固定使用 5005
TRANSLATOR_PORT=5005

# 生产环境关闭调试；Docker Compose 同时强制关闭
FLASK_DEBUG=false

# 自定义语言配置（可选）
# 格式: 语言代码:语言名称,多个用逗号分隔
# 示例: CUSTOM_LANGUAGES=ko:韩语,ru:俄语,ar:阿拉伯语,de:德语
# 语言代码建议使用 ISO 639-1 标准两位代码
CUSTOM_LANGUAGES=
